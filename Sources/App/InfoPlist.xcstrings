{
  "sourceLanguage": "en-GB",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to talk to the writing assistant."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para conversar com o assistente de escrita."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para hablar con el asistente de escritura."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, um mit dem Schreibassistenten zu sprechen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Służy do rozmowy z asystentem pisania."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour parler à l’assistant d’écriture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato per parlare con l’assistente di scrittura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于与写作助手对话。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to transcribe what you say to the writing assistant."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para transcrever o que você diz ao assistente de escrita."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para transcribir lo que le dices al asistente de escritura."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, um zu transkribieren, was du dem Schreibassistenten sagst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Służy do zapisywania tego, co mówisz do asystenta pisania."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour transcrire ce que vous dites à l’assistant d’écriture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato per trascrivere ciò che dici all’assistente di scrittura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于转写你对写作助手说的话。"
          }
        }
      }
    }
  },
  "version": "1.0"
