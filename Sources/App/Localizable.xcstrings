    "This article also changed on disk, so your edits can't be saved for you without overwriting that. Opening another article now discards them — resolve the conflict first if you want to keep them.": {
      "comment": "L.App.alsoChangedOnDisk",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This article also changed on disk, so your edits can't be saved for you without overwriting that. Opening another article now discards them — resolve the conflict first if you want to keep them."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este artigo também mudou no disco, então suas edições não podem ser salvas sem sobrescrever isso. Abrir outro artigo agora as descarta — resolva o conflito antes se quiser mantê-las."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Este artículo también cambió en el disco, así que tus ediciones no se pueden guardar sin sobrescribir eso. Abrir otro artículo ahora las descarta: resuelve el conflicto primero si quieres conservarlas."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Artikel wurde auch auf dem Datenträger geändert, deine Änderungen lassen sich also nicht sichern, ohne das zu überschreiben. Wenn du jetzt einen anderen Artikel öffnest, gehen sie verloren — löse zuerst den Konflikt, wenn du sie behalten willst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten artykuł zmienił się też na dysku, więc twoich zmian nie da się zapisać bez nadpisania tamtych. Otwarcie innego artykułu teraz je odrzuci — najpierw rozwiąż konflikt, jeśli chcesz je zachować."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet article a aussi changé sur le disque, vos modifications ne peuvent donc pas être enregistrées sans l’écraser. Ouvrir un autre article maintenant les abandonne — résolvez d’abord le conflit si vous voulez les garder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche questo articolo è cambiato sul disco, quindi le tue modifiche non si possono salvare senza sovrascriverlo. Aprire un altro articolo ora le scarta: risolvi prima il conflitto se vuoi tenerle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这篇文章在磁盘上也已更改，因此无法在不覆盖它的情况下保存你的编辑。现在打开另一篇文章会放弃这些编辑——如需保留，请先解决冲突。"
          }
        }
      }
    },
    "This discards every edit made since the last save and can't be undone.": {
      "comment": "L.Editor.thisDiscardsEveryEditMade",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This discards every edit made since the last save and can't be undone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso descarta todas as edições feitas desde o último salvamento e não pode ser desfeito."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto descarta todas las ediciones desde el último guardado y no se puede deshacer."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden alle Änderungen seit dem letzten Sichern verworfen. Das kann nicht widerrufen werden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To odrzuci wszystkie zmiany od ostatniego zapisu i nie da się tego cofnąć."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela annule toutes les modifications depuis le dernier enregistrement, de façon irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo scarta ogni modifica dall’ultimo salvataggio e non si può annullare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会放弃上次保存以来的所有编辑，且无法撤销。"
          }
        }
      }
    },
    "This file changed on disk while you were editing it.": {
      "comment": "L.Editor.thisFileChangedOnDisk",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This file changed on disk while you were editing it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo mudou no disco enquanto você o editava."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo cambió en el disco mientras lo editabas."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei wurde auf dem Datenträger geändert, während du sie bearbeitet hast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik zmienił się na dysku podczas edycji."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier a changé sur le disque pendant que vous le modifiiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file è cambiato sul disco mentre lo modificavi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你编辑时，此文件在磁盘上被更改了。"
          }
        }
      }
    },
    "Title": {
      "comment": "L.Common.title",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
