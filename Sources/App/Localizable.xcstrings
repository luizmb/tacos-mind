{
  "sourceLanguage": "en-GB",
  "strings": {
    "%@ will be replaced by what's on GitHub. This can't be undone.": {
      "comment": "L.Sync.willBeReplacedByWhats",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be replaced by what's on GitHub. This can't be undone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ será substituído pelo que está no GitHub. Isso não pode ser desfeito."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se sustituirá por lo que hay en GitHub. No se puede deshacer."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird durch den Stand auf GitHub ersetzt. Das kann nicht widerrufen werden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zostanie zastąpiony wersją z GitHub. Tego nie da się cofnąć."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sera remplacé par ce qui est sur GitHub. C’est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verrà sostituito da ciò che c’è su GitHub. Non si può annullare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将被 GitHub 上的内容替换，且无法撤销。"
          }
        }
      }
    },
    "%lld articles will be committed.": {
