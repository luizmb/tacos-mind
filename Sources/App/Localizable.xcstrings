    "Pull reads from this branch, and pushes open a pull request into it.": {
      "comment": "L.Sync.pullReadsFromThisBranch",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull reads from this branch, and pushes open a pull request into it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pull lê deste branch, e os pushes abrem um pull request para ele."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull lee de esta rama, y los push abren una pull request hacia ella."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull liest aus diesem Branch, und Pushes öffnen einen Pull Request in ihn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull czyta z tej gałęzi, a push otwiera do niej pull request."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull lit cette branche, et les push y ouvrent une pull request."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pull legge da questo branch, e i push vi aprono una pull request."
          }
        },
