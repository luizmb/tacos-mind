          "stringUnit": {
            "state": "translated",
            "value": "拉取会读取此分支，推送会向其发起拉取请求。"
          }
        }
      }
    },
    "Pull reads from this branch, and pushes open a pull request into it. Nothing is ever committed to it directly.": {
      "comment": "L.Sync.pullReadsNothingCommitted",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull reads from this branch, and pushes open a pull request into it. Nothing is ever committed to it directly."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pull lê deste branch, e os pushes abrem um pull request para ele. Nada é enviado diretamente para ele."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull lee de esta rama, y los push abren una pull request hacia ella. Nunca se hace commit directamente en ella."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull liest aus diesem Branch, und Pushes öffnen einen Pull Request in ihn. Direkt wird nie in ihn committet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull czyta z tej gałęzi, a push otwiera do niej pull request. Nic nie jest do niej zatwierdzane bezpośrednio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull lit cette branche, et les push y ouvrent une pull request. Rien n’y est jamais commité directement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pull legge da questo branch, e i push vi aprono una pull request. Non viene mai fatto commit direttamente su di esso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取会读取此分支，推送会向其发起拉取请求。从不直接提交到该分支。"
          }
        }
      }
    },
