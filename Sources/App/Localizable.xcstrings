    "A new branch off %@. Reusing an existing name adds to its pull request.": {
      "comment": "L.Sync.aNewBranchOffReusing",
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A new branch off %@. Reusing an existing name adds to its pull request."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo branch a partir de %@. Reusar um nome existente acrescenta ao pull request dele."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Una rama nueva a partir de %@. Reutilizar un nombre existente se suma a su pull request."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Branch von %@. Ein vorhandener Name ergänzt dessen Pull Request."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa gałąź od %@. Użycie istniejącej nazwy dopisuje do jej pull requesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle branche à partir de %@. Réutiliser un nom existant complète sa pull request."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuovo branch da %@. Riusare un nome esistente aggiunge alla sua pull request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 %@ 新建分支。重用现有名称会追加到其拉取请求中。"
          }
        }
      }
    },
